# ── Anthropic（默认）──────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
MODEL=claude-sonnet-4-6

# ── 国内模型（OpenAI-Compatible API）─────────────────────────────────────────
# 取消注释下方配置并注释上方配置即可切换
# LLM_PROVIDER 和 LLM_API_KEY / LLM_BASE_URL / MODEL 是 openai-compatible 模式专用
# ANTHROPIC_API_KEY 在 openai-compatible 模式下不需要

# DeepSeek（推荐，函数调用质量高，性价比极佳）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# 通义千问（阿里云，国内稳定）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-max

# 月之暗面 Moonshot（长上下文）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-128k

# 智谱 GLM
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# MODEL=glm-4-plus

# 豆包（字节跳动）
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL=ep-xxxxxxxx-xxxx

# ── Ollama 本地模型（推荐 14B-32B 量化版本）─────────────────────────────────
# LLM_PROVIDER=ollama
# MODEL=qwen3:27b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CONNECT_TIMEOUT=30        # 首次加载模型到 VRAM 的超时（秒）
# OLLAMA_READ_TIMEOUT=300          # 单次生成最长等待（秒）
# OLLAMA_CONTEXT_WINDOW=32768      # 模型上下文窗口大小
# OLLAMA_KEEPALIVE=30              # 模型在 VRAM 中保持加载的时间（分钟）
# OLLAMA_CHARS_PER_TOKEN=1.5       # 中文字符对应 token 数（用于估算）

# ── MCP 外部工具服务器（可选）────────────────────────────────────────────────
# 通过 Model Context Protocol 接入外部工具
# JSON 格式：{服务器名: {command: 启动命令, args: [参数列表]}}
# MCP_SERVERS={"novel_research": {"command": "npx", "args": ["-y", "novel-research-server"]}}

# ── LLM 调用缓存（可选，开发调试用）───────────────────────────────────────────
# 启用后对相同请求返回缓存结果，避免重复 LLM 调用
# LLM_CACHE_ENABLED=true

# ── 模型路由（可选，成本优化用）────────────────────────────────────────────────
# 不同 Agent 使用不同模型（JSON 格式：{agent_name: model_id}）
# 未配置的 Agent 使用默认 MODEL
# MODEL_ROUTING={"writer_summary": "claude-haiku-4-5-20251001", "plot_planner": "claude-opus-4-6"}
